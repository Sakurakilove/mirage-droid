+#if defined(__ANDROID__)
+/*
+ * bionic does not implement POSIX shared-memory objects: shm_open() and
+ * shm_unlink() are missing from the libc entirely.  Emulate them with a
+ * regular file under the temporary directory (the same approach Termux's
+ * QEMU package takes).  QEMU only reaches qemu_shm_alloc() for
+ * `-object memory-backend=shm`, which the miwear boards never use, but this
+ * keeps the shared-memory backend functional for anyone who asks for it.
+ */
+static int shm_unlink(const char *name)
+{
+    g_autofree char *fname = NULL;
+
+    while (*name == '/') {
+        name++;
+    }
+    if (*name == '\0') {
+        errno = EINVAL;
+        return -1;
+    }
+    fname = g_strdup_printf("%s/%s", g_get_tmp_dir(), name);
+    return unlink(fname);
+}
+
+static int shm_open(const char *name, int oflag, mode_t mode)
+{
+    g_autofree char *fname = NULL;
+    int fd, flags;
+
+    while (*name == '/') {
+        name++;
+    }
+    if (*name == '\0') {
+        errno = EINVAL;
+        return -1;
+    }
+    fname = g_strdup_printf("%s/%s", g_get_tmp_dir(), name);
+    fd = open(fname, oflag, mode);
+    if (fd < 0) {
+        return fd;
+    }
+    flags = fcntl(fd, F_GETFD, 0);
+    if (flags != -1 && fcntl(fd, F_SETFD, flags | FD_CLOEXEC) == -1) {
+        int saved_errno = errno;
+        close(fd);
+        errno = saved_errno;
+        return -1;
+    }
+    return fd;
+}
+#endif /* __ANDROID__ */
