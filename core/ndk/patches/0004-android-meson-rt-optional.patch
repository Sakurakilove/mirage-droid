--- a/meson.build
+++ b/meson.build
@@ -1372,7 +1372,12 @@
 if host_os != 'windows'
   have_shm_open = cc.has_function('shm_open')
   if not have_shm_open
-    rt = cc.find_library('rt', required: true)
+    # Android/bionic has neither shm_open() nor a separate librt (the POSIX
+    # clock and shared-memory entry points live in libc).  util/oslib-posix.c
