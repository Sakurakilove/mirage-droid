+    # (core/ndk/patches/0001), so the librt fallback must not be mandatory
+    # there.  cc.get_define() is a preprocessor probe, safe when crossing.
+    rt = cc.find_library('rt', required: cc.get_define('__ANDROID__') == '')
   endif
 endif
 
