<resources>
    <!-- 全程用 android.* 原生控件 + 框架 Material 深色主题：
         避免 AppCompat/Material 组件的 inflater 依赖（App 是纯 android.app.Activity）。 -->
    <style name="Theme.MirageDroid" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand_primary</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
